<!-- 角色与人物详情页共用的模板，文案由页面 data 中的 kindLabel / relatedLabel 提供。 -->
<view class="detail-page">
  <view class="detail-page__chrome">
    <app-header
      title="{{loaded && !errorMessage && heroTitleHidden ? title : ''}}"
      back
      transparent
      bindback="onBack"
      bindheaderheightchange="onHeaderHeightChange"
    ></app-header>
    <view wx:if="{{tabsStuck && loaded}}" class="detail-page__chrome-tabs">
      <ui-tabs value="{{tab}}" tabs="{{tabs}}" bindchange="onTabChange"></ui-tabs>
    </view>
  </view>

  <scroll-view wx:if="{{!loaded}}" class="detail-page__scroll" type="custom" scroll-y show-scrollbar="{{false}}">
    <view style="height: {{headerHeight}}px;"></view>
    <ui-skeleton wx:if="{{loading}}" variant="detail-portrait"></ui-skeleton>
    <ui-empty has-action wx:elif="{{errorMessage}}" symbol="!" title="{{kindLabel}}详情加载失败" description="{{errorMessage}}" variant="plain">
      <ui-button slot="action" variant="outline" size="sm" bindtap="onRetry">重试</ui-button>
    </ui-empty>
  </scroll-view>

  <scroll-view wx:else class="detail-page__scroll" type="nested" scroll-y show-scrollbar="{{false}}">
    <nested-scroll-header>
    <view class="detail-page__hero-header {{tabsStuck ? 'detail-page__hero-header--hidden' : ''}}">
    <view style="height: {{headerHeight}}px;"></view>
      <detail-hero
        title="{{title}}"
        header-height="{{headerHeight}}"
        bindtitlevisibilitychange="onTitleVisibilityChange"
        bindmedialayoutchange="onHeroMediaLayoutChange"
        image-url="{{imageUrl}}"
        image-variant="portrait"
        badges="{{badges}}"
        summary="{{summary}}"
      ></detail-hero>

      <view class="detail-page__actions"><detail-share-button></detail-share-button></view>
    </view>
    </nested-scroll-header>

    <nested-scroll-header>
      <view class="detail-page__tabs {{tabsStuck ? 'detail-page__tabs--placeholder' : ''}}">
        <view class="detail-page__tab-sentinel"></view>
        <ui-tabs wx:if="{{!tabsStuck}}" value="{{tab}}" tabs="{{tabs}}" bindchange="onTabChange"></ui-tabs>
      </view>
    </nested-scroll-header>

    <nested-scroll-body class="detail-page__body" offset-top="{{headerHeight + 48}}">
      <swiper class="detail-page__swiper" style="--detail-panel-inset: {{headerHeight + 48}}px;" current="{{tabIndex}}" bindchange="onSwiperChange">
        <swiper-item>
          <scroll-view class="detail-page__tab-scroll" type="custom" scroll-y show-scrollbar="{{false}}" associative-container="nested-scroll-view">
            <view class="detail-page__panel-start"></view>
            <grid-view
              wx:if="{{subjectsLoading || !subjectsLoaded && !subjectsError}}"
              type="aligned"
              cross-axis-count="2"
              main-axis-gap="12"
              cross-axis-gap="12"
              padding="{{[0, 16, 0, 16]}}"
            >
              <ui-skeleton wx:for="{{panelSkeletonRows}}" wx:key="*this" variant="poster"></ui-skeleton>
            </grid-view>
            <ui-empty has-action wx:elif="{{subjectsError}}" symbol="!" title="关联内容加载失败" description="{{subjectsError}}" variant="plain">
              <ui-button slot="action" variant="outline" size="sm" bindtap="onRetryPanel">重试</ui-button>
            </ui-empty>
            <ui-empty
              wx:elif="{{subjects.length === 0}}"
              title="暂无关联条目"
              description="这个{{kindLabel}}还没有可浏览的关联条目。"
            ></ui-empty>
            <block wx:else>
              <block wx:for="{{subjects}}" wx:key="relation" wx:for-item="group">
                <view class="detail-page__section-title"><text>{{group.relation}}</text></view>
                <grid-view type="aligned" cross-axis-count="2" main-axis-gap="12" cross-axis-gap="12" padding="{{[0, 16, 0, 16]}}">
                  <poster-card
                    wx:for="{{group.items}}"
                    wx:key="key"
                    wx:for-item="subject"
                    subject-id="{{subject.id}}"
                    image-url="{{subject.imageUrl}}"
                    title="{{subject.title}}"
                    public-link
                  ></poster-card>
                </grid-view>
              </block>
            </block>
            <view class="detail-page__panel-end"></view>
          </scroll-view>
        </swiper-item>
        <swiper-item>
          <scroll-view class="detail-page__tab-scroll" type="custom" scroll-y show-scrollbar="{{false}}" associative-container="nested-scroll-view">
            <view class="detail-page__panel-start"></view>
            <list-view wx:if="{{relatedLoading || !relatedLoaded && !relatedError}}">
              <ui-skeleton wx:for="{{panelSkeletonRows}}" wx:key="*this" variant="entity"></ui-skeleton>
            </list-view>
            <ui-empty has-action wx:elif="{{relatedError}}" symbol="!" title="关联内容加载失败" description="{{relatedError}}" variant="plain">
              <ui-button slot="action" variant="outline" size="sm" bindtap="onRetryPanel">重试</ui-button>
            </ui-empty>
            <ui-empty
              wx:elif="{{related.length === 0}}"
              title="暂无关联{{relatedLabel}}"
              description="这个{{kindLabel}}还没有可浏览的关联{{relatedLabel}}。"
            ></ui-empty>
            <block wx:else>
              <block wx:for="{{related}}" wx:key="relation" wx:for-item="group">
                <view class="detail-page__section-title"><text>{{group.relation}}</text></view>
                <list-view>
                  <entity-row
                    wx:for="{{group.items}}"
                    wx:key="key"
                    entity-id="{{item.id}}"
                    target="{{item.target}}"
                    name="{{item.name}}"
                    image-url="{{item.imageUrl}}"
                    image-top
                    description="{{item.description}}"
                    public-link
                  ></entity-row>
                </list-view>
              </block>
            </block>
            <view class="detail-page__panel-end"></view>
          </scroll-view>
        </swiper-item>
      </swiper>
    </nested-scroll-body>
  </scroll-view>
</view>
