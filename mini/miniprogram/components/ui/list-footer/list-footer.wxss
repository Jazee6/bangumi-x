.list-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72px;
  padding: 12px 16px 24px;
}

.list-footer__loading {
  display: flex;
  align-items: center;
  color: var(--muted-foreground);
  font-size: 13px;
}

.list-footer__spinner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  margin-right: 8px;
  flex-shrink: 0;
}
