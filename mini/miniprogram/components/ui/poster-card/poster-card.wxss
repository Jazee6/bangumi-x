.poster-card {
  position: relative;
  min-width: 0;
  padding-bottom: 8px;
}

.poster-card__link {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.poster-card--pressed {
  opacity: 0.75;
}

.poster-card__media {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  height: 0;
  padding-bottom: 150%;
  border-radius: var(--radius-lg);
  background: var(--muted);
}

.poster-card__image,
.poster-card__placeholder {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.poster-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted-foreground);
  font-size: 12px;
}

.poster-card__badge {
  position: absolute;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 20px;
  padding: 0 6px;
  border: 1px solid var(--border);
  border-radius: 999px;
  color: var(--foreground);
  /* 网格里每张卡最多两枚徽标，逐个 backdrop-filter 会拖慢 Skyline 滚动；只保留半透明底色。 */
  background: var(--background-blur);
  font-size: 12px;
  font-weight: 500;
  line-height: 18px;
}

.poster-card__badge-text {
  transform: translateY(1px);
}

.poster-card__score {
  top: 8px;
  right: 8px;
}

.poster-card__rank {
  bottom: 8px;
  left: 8px;
}

.poster-card__title {
  overflow: hidden;
  margin-top: 8px;
  color: var(--foreground);
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  word-break: break-all;
}
