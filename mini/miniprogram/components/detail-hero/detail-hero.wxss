.detail-hero {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  padding: 16px 16px 12px;
  flex-direction: column;
}

.detail-hero__media {
  position: relative;
  overflow: hidden;
  width: 62%;
  max-width: 248px;
  border-radius: var(--radius-md);
  background: var(--muted);
}

.detail-hero__media--poster {
  width: 44%;
  max-width: 176px;
  aspect-ratio: 2 / 3;
}

.detail-hero__media--portrait {
  width: 100%;
}

.detail-hero__image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.detail-hero__media--portrait .detail-hero__image {
  position: relative;
  height: auto;
}

.detail-hero__title-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  margin-top: 16px;
  gap: 4px;
}

.detail-hero__title-row--first {
  margin-top: 0;
}

.detail-hero__title {
  min-width: 0;
  color: var(--foreground);
  font-size: 28px;
  font-weight: 700;
  line-height: 36px;
  word-break: break-all;
  flex-shrink: 1;
}

.detail-hero__copy-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: var(--radius-4xl);
  color: var(--foreground);
  flex-shrink: 0;
}

.detail-hero__copy-button--pressed {
  background: var(--muted);
}

.detail-hero__copy-icon {
  position: relative;
  width: 16px;
  height: 16px;
}

.detail-hero__copy-icon::before,
.detail-hero__copy-icon::after {
  position: absolute;
  box-sizing: border-box;
  width: 11px;
  height: 11px;
  border: 1.5px solid currentColor;
  border-radius: 2px;
  background: var(--background);
  content: "";
}

.detail-hero__copy-icon::before {
  top: 1px;
  left: 1px;
}

.detail-hero__copy-icon::after {
  right: 1px;
  bottom: 1px;
}

.detail-hero__original {
  margin-top: 6px;
  color: var(--muted-foreground);
  font-size: 14px;
  line-height: 21px;
  word-break: break-all;
}

.detail-hero__badges,
.detail-hero__tags {
  display: flex;
  align-items: center;
  margin-top: 12px;
  gap: 8px;
  flex-wrap: wrap;
}

.detail-hero__summary {
  display: flex;
  margin-top: 16px;
  flex-direction: column;
}

.detail-hero__summary-text,
.detail-hero__summary-empty {
  color: var(--muted-foreground);
  font-size: 15px;
  line-height: 25px;
  white-space: pre-line;
  word-break: break-all;
}

.detail-hero__summary-toggle {
  align-self: flex-start;
  margin-top: 8px;
  color: var(--foreground);
  font-size: 14px;
  font-weight: 500;
  line-height: 24px;
}

.detail-hero__summary-toggle--pressed {
  opacity: 0.6;
}
