.profile-page {
  position: relative;
  display: flex;
  overflow: hidden;
  width: 100%;
  height: 100vh;
  background: var(--muted);
  flex-direction: column;
}

.profile-page__header {
  position: absolute;
  z-index: 10;
  top: 0;
  right: 0;
  left: 0;
}

.profile-page__scroll {
  flex: 1;
  min-height: 0;
}

.profile-content {
  box-sizing: border-box;
  width: 100%;
  padding: 16px 16px 32px;
}

.profile-avatar {
  flex: none;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--secondary);
}

.profile-avatar--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--secondary-foreground);
  font-size: 20px;
  font-weight: 600;
}

.profile-avatar--fallback text {
  transform: translateY(2px);
}

.profile-name-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.profile-name-form__description {
  color: var(--muted-foreground);
  font-size: 13px;
  line-height: 20px;
}

.profile-name-form__input {
  box-sizing: border-box;
  width: 100%;
  height: 44px;
  padding: 0 12px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  color: var(--foreground);
  background: var(--background);
  font-size: 15px;
}

.profile-name-form__error {
  color: var(--destructive);
  font-size: 13px;
  line-height: 20px;
}
