<view class="records-page">
  <view class="records-page__header public-page-header--blur">
    <app-header title="收藏" back transparent bindback="onBack" bindheaderheightchange="onHeaderHeightChange"></app-header>
    <view class="list-controls">
      <view class="records-controls__row">
        <scroll-view class="scope-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
          <ui-tabs variant="pill" fit tabs="{{scopeTabs}}" value="{{scope}}" bindchange="onSelectScope"></ui-tabs>
        </scroll-view>
        <picker class="records-controls__select" mode="selector" range="{{typeLabels}}" value="{{typeIndex}}" bindchange="onTypeChange">
          <ui-select-trigger label="{{typeLabels[typeIndex]}}"></ui-select-trigger>
        </picker>
      </view>
    </view>
  </view>
  <scroll-view class="records-page__scroll" type="custom" scroll-y enhanced show-scrollbar="{{false}}" lower-threshold="200" bindscrolltolower="onScrollLower">
    <view style="height: {{headerHeight}}px;"></view>
    <view class="list-controls-spacer"></view>
    <view class="records-controls">
      <keyword-search value="{{keywordInput}}" loading="{{loading}}" bindinput="onKeywordInput" bindsearch="onSearch" bindclear="onClearKeyword"></keyword-search>
    </view>

    <grid-view wx:if="{{loading && !loaded}}" class="records-grid" type="aligned" cross-axis-count="2" main-axis-gap="12" cross-axis-gap="12" padding="{{[12, 16, 16, 16]}}">
      <ui-skeleton variant="poster"></ui-skeleton>
      <ui-skeleton variant="poster"></ui-skeleton>
      <ui-skeleton variant="poster"></ui-skeleton>
      <ui-skeleton variant="poster"></ui-skeleton>
      <ui-skeleton variant="poster"></ui-skeleton>
      <ui-skeleton variant="poster"></ui-skeleton>
    </grid-view>
    <ui-empty has-action wx:elif="{{errorMessage}}" symbol="!" title="收藏加载失败" description="{{errorMessage}}" variant="plain">
      <ui-button slot="action" variant="outline" size="sm" bindtap="onRetry">重试</ui-button>
    </ui-empty>
    <ui-empty wx:elif="{{loaded && items.length === 0}}" icon="{{keyword ? 'search' : 'bookmark-x'}}" title="{{keyword ? '没有找到匹配收藏' : '暂无收藏'}}" description="{{keyword ? '可以尝试其他关键词。' : '可在条目详情中添加收藏。'}}"></ui-empty>
    <grid-view wx:else class="records-grid" type="aligned" cross-axis-count="2" main-axis-gap="12" cross-axis-gap="12" padding="{{[12, 16, 16, 16]}}">
      <poster-card wx:for="{{items}}" wx:key="id" subject-id="{{item.id}}" image-url="{{item.imageUrl}}" title="{{item.title}}" bindselect="onOpenSubject"></poster-card>
    </grid-view>
    <list-footer state="{{footerState}}" bindretry="onRetryMore"></list-footer>
    <view class="records-page__bottom-space {{selectedList ? 'records-page__bottom-space--manage' : ''}}" aria-hidden="true"></view>
  </scroll-view>

  <view class="records-fab">
    <ui-action-button wx:if="{{selectedList}}" icon="ellipsis" icon-only size="fab" variant="outline" aria-label="管理列表" disabled="{{submitting}}" bindpress="onOpenManage"></ui-action-button>
    <ui-action-button icon="plus" icon-only size="fab" variant="default" aria-label="新建列表" disabled="{{submitting}}" bindpress="onOpenCreate"></ui-action-button>
  </view>

  <ui-sheet open="{{sheetOpen}}" title="{{sheetTitle}}" footer-visible="{{false}}" bindclose="onCloseSheet" bindclosed="onSheetClosed" binddismiss="onSheetDismissed">
    <view wx:if="{{sheetMode === 'manage' && selectedList}}">
      <ui-item-group>
        <ui-item title="名称" value="{{selectedList.name}}" chevron pressable="{{!submitting}}" bindtap="onEditListName"></ui-item>
        <ui-item bordered title="可见性" value="{{selectedList.isPublic ? '公开' : '私密'}}" chevron pressable="{{!submitting}}" bindtap="onToggleVisibility"></ui-item>
        <block wx:if="{{selectedList.isPublic}}">
          <ui-item bordered title="分享给微信好友" chevron pressable="{{false}}">
            <button class="ui-item-overlay" open-type="share" aria-label="分享给微信好友"></button>
          </ui-item>
          <ui-item bordered title="复制 Web 链接" chevron bindtap="onCopyWebLink"></ui-item>
          <ui-item bordered title="查看公开页" chevron bindtap="onPreviewPublicList"></ui-item>
        </block>
        <ui-item bordered title="删除列表" destructive pressable="{{!submitting}}" bindtap="onRequestDelete"></ui-item>
      </ui-item-group>
    </view>
  </ui-sheet>
</view>
