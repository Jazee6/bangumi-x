.link-content,
.link-card,
.link-card__header,
.link-actions {
  display: flex;
  flex-direction: column;
}

.link-content {
  gap: 24px;
}

/* ui-button 自带 margin: 0，会覆盖外部类传入的外边距；间距统一由容器 gap 控制。 */
.link-card,
.link-actions {
  gap: 12px;
}

.link-card__header {
  padding-bottom: 4px;
  gap: 6px;
}

.link-card__title,
.link-note__title {
  color: var(--foreground);
  font-size: 16px;
  font-weight: 600;
  line-height: 24px;
}

.link-card__description {
  color: var(--muted-foreground);
  font-size: 14px;
  line-height: 21px;
}

.link-divider {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  color: var(--muted-foreground);
  font-size: 12px;
  gap: 10px;
}

.link-divider__line {
  height: 1px;
  background: var(--border);
  flex: 1;
}

.link-code-input {
  box-sizing: border-box;
  width: 100%;
  height: 44px;
  padding: 0 12px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  color: var(--foreground);
  background: var(--background);
  font-size: 18px;
  font-weight: 600;
  letter-spacing: 2px;
  text-align: center;
}

.link-note {
  display: flex;
  padding-top: 16px;
  border-top: 1px solid var(--border);
  color: var(--muted-foreground);
  font-size: 13px;
  line-height: 21px;
  flex-direction: column;
  gap: 4px;
}

.link-note__title {
  margin-bottom: 4px;
}

.preview-parties {
  display: flex;
  align-items: stretch;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: var(--radius-2xl);
}

.preview-party {
  display: flex;
  min-width: 0;
  padding: 4px;
  flex: 1;
  flex-direction: column;
}

.preview-party__eyebrow {
  color: var(--muted-foreground);
  font-size: 12px;
  line-height: 18px;
}

.preview-party__name {
  overflow: hidden;
  margin-top: 2px;
  color: var(--foreground);
  font-size: 15px;
  font-weight: 600;
  line-height: 22px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-counts {
  display: flex;
  margin-top: 8px;
  color: var(--muted-foreground);
  font-size: 12px;
  line-height: 18px;
  flex-direction: column;
}

.preview-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  color: var(--muted-foreground);
  font-size: 18px;
}
