.progress-page {
  position: relative;
  display: flex;
  overflow: hidden;
  width: 100%;
  height: 100vh;
  background: var(--background);
  flex-direction: column;
}

.progress-page__header {
  position: absolute;
  z-index: 20;
  top: 0;
  right: 0;
  left: 0;
}

.progress-page__scroll {
  flex: 1;
  min-height: 0;
}

.progress-controls {
  padding: 4px 16px 0;
}

.progress-controls__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.progress-list {
  padding: 12px 16px 20px;
}

.progress-card {
  display: flex;
  min-width: 0;
  margin-bottom: 8px;
  padding: 8px;
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  background: var(--background);
  gap: 8px;
}

.progress-card__image-link {
  flex: none;
  align-self: flex-start;
}

.progress-card__link--pressed {
  opacity: 0.75;
}

.progress-card__image {
  width: 64px;
  height: 108px;
  border-radius: var(--radius-md);
  background: var(--muted);
}

.progress-card__image--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted-foreground);
  font-size: 11px;
}

.progress-card__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
}

.progress-card__heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  width: 100%;
  min-width: 0;
  gap: 8px;
}

.progress-card__title {
  min-width: 0;
  flex: 1;
  color: var(--foreground);
  font-size: 15px;
  font-weight: 600;
  line-height: 22px;
}

.progress-card__type {
  flex: none;
  color: var(--muted-foreground);
  font-size: 12px;
  line-height: 22px;
}

.progress-card__broadcast {
  display: flex;
  max-width: 100%;
  margin-top: 8px;
}

.progress-card__actions {
  display: flex;
  align-items: center;
  margin-top: auto;
  padding-top: 12px;
  flex-wrap: wrap;
  gap: 6px;
}

.progress-controls__select {
  flex: none;
  margin-left: 10px;
}
