.about-page {
  position: relative;
  display: flex;
  overflow: hidden;
  width: 100%;
  height: 100vh;
  background: var(--muted);
  flex-direction: column;
}

.about-page__header {
  position: absolute;
  z-index: 10;
  top: 0;
  right: 0;
  left: 0;
}

.about-page__scroll {
  flex: 1;
  min-height: 0;
}

.about-content {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  padding: 16px 16px 32px;
  flex-direction: column;
  gap: 16px;
}
