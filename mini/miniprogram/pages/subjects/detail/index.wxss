@import "../../../styles/detail.wxss";

.subject-actions {
  position: relative;
  width: 100%;
  height: 60px;
}

.subject-actions__scroll {
  box-sizing: border-box;
  width: 100%;
  height: 60px;
}

.subject-actions__fade {
  position: absolute;
  z-index: 1;
  top: 4px;
  bottom: 12px;
  width: 20px;
  pointer-events: none;
}

.subject-actions__fade--left {
  left: 0;
  background: linear-gradient(to right, var(--background), transparent);
}

.subject-actions__fade--right {
  right: 0;
  background: linear-gradient(to left, var(--background), transparent);
}

.subject-actions__row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-width: 100%;
  height: 60px;
  padding: 4px 16px 12px;
  gap: 8px;
}

.detail-sheet {
  display: flex;
  gap: 12px;
  flex-direction: column;
}

.detail-sheet__options {
  display: flex;
  gap: 12px;
  flex-direction: column;
}

.detail-sheet__option {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 46px;
  padding: 8px 12px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
}

.detail-sheet__option--selected {
  background: var(--secondary);
}

.detail-sheet__option checkbox {
  margin-right: 10px;
  flex-shrink: 0;
}

.detail-sheet__option-name {
  min-width: 0;
  color: var(--foreground);
  font-size: 14px;
  flex: 1;
}

.detail-sheet__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
}
