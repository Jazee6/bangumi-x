.public-list-page {
  position: relative;
  display: flex;
  overflow: hidden;
  width: 100%;
  height: 100vh;
  background: var(--background);
  flex-direction: column;
}

.public-list-page__header {
  position: absolute;
  z-index: 20;
  top: 0;
  right: 0;
  left: 0;
}

.public-list-page__scroll {
  flex: 1;
  min-height: 0;
}

.public-list-page__bottom-space {
  height: 88px;
  padding-bottom: env(safe-area-inset-bottom);
}

.public-list-fab {
  position: absolute;
  z-index: 10;
  right: 16px;
  bottom: env(safe-area-inset-bottom);
  padding-bottom: 16px;
}

.public-list-summary {
  padding: 20px 16px 8px;
}

.public-list-summary__title {
  display: block;
  color: var(--foreground);
  font-size: 24px;
  font-weight: 700;
  line-height: 32px;
}

.public-list-summary__meta {
  display: block;
  margin-top: 6px;
  color: var(--muted-foreground);
  font-size: 13px;
  line-height: 20px;
}

.public-list-grid {
  width: 100%;
}
