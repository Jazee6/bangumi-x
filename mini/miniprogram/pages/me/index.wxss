.me-page {
  position: relative;
  display: flex;
  overflow: hidden;
  width: 100%;
  height: 100vh;
  background: var(--muted);
  flex-direction: column;
}

.me-page__header {
  position: absolute;
  z-index: 10;
  top: 0;
  right: 0;
  left: 0;
}

.me-page__scroll {
  flex: 1;
  min-height: 0;
}

.me-content {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  padding: 16px 16px 32px;
  flex-direction: column;
  gap: 16px;
}

.profile-card {
  border: 1px solid var(--border);
  border-radius: var(--radius-2xl);
  background: var(--background);
}

.profile-card {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 72px;
  padding: 12px;
}

.profile-card__avatar {
  flex: none;
  width: 45px;
  height: 45px;
  border-radius: 50%;
  background: var(--secondary);
}

.profile-card__avatar--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--secondary-foreground);
  font-size: 24px;
  font-weight: 600;
}

.profile-card__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.profile-card__body {
  margin-left: 14px;
}

.profile-card__name {
  overflow: hidden;
  color: var(--foreground);
  font-size: 18px;
  font-weight: 600;
  line-height: 26px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-card__status {
  color: var(--muted-foreground);
  font-size: 13px;
  line-height: 19px;
}

.profile-card--pressed {
  opacity: 0.72;
}

.profile-card__chevron {
  display: flex;
  flex: none;
  margin: 0 0 0 12px;
}
