<view class="public-page">
  <view class="public-page-header public-page-header--blur">
    <app-header title="发现" transparent bindheaderheightchange="onHeaderHeightChange"></app-header>
    <view class="list-controls">
      <view class="discover-controls__row">
        <ui-tabs variant="pill" fit tabs="{{tabs}}" value="{{tab}}" bindchange="onTabChange"></ui-tabs>
        <picker class="discover-controls__select"
          wx:if="{{tab === 'subjects'}}"
          mode="selector"
          range="{{subjectTypeLabels}}"
          value="{{subjectTypeIndex}}"
          bindchange="onSubjectTypeChange"
        >
          <ui-select-trigger label="{{subjectTypeLabel}}"></ui-select-trigger>
        </picker>
      </view>
    </view>
  </view>
  <scroll-view
    class="public-scroll"
    type="custom"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    lower-threshold="200"
    bindscrolltolower="onScrollLower"
  >
    <view style="height: {{headerHeight}}px;"></view>
    <view class="list-controls-spacer"></view>
    <view class="discover-controls {{tab !== 'subjects' && (loading || entities.length > 0 || errorMessage) ? 'discover-controls--entity' : ''}}">
      <keyword-search value="{{keywordInput}}" loading="{{loading}}" bindinput="onKeywordInput" bindsearch="onSearch" bindclear="onClearKeyword"></keyword-search>
    </view>

    <grid-view wx:if="{{loading && tab === 'subjects'}}" class="poster-grid" type="aligned" cross-axis-count="2" main-axis-gap="12" cross-axis-gap="12" padding="{{[16, 16, 16, 16]}}">
      <ui-skeleton wx:for="{{posterSkeletons}}" wx:key="*this" variant="poster"></ui-skeleton>
    </grid-view>

    <list-view wx:elif="{{loading}}" class="entity-list">
      <ui-skeleton wx:for="{{entitySkeletons}}" wx:key="*this" variant="entity"></ui-skeleton>
    </list-view>

    <ui-empty has-action wx:elif="{{errorMessage}}" symbol="!" title="发现内容加载失败" description="{{errorMessage}}" variant="plain">
      <ui-button slot="action" variant="outline" size="sm" bindtap="onRetry">重试</ui-button>
    </ui-empty>

    <ui-empty wx:elif="{{loaded && posters.length === 0 && entities.length === 0}}" icon="{{tab === 'subjects' && !keyword ? 'image-off' : 'search'}}" title="{{emptyTitle}}" description="{{emptyDescription}}"></ui-empty>

    <grid-view wx:elif="{{tab === 'subjects'}}" class="poster-grid" type="aligned" cross-axis-count="2" main-axis-gap="12" cross-axis-gap="12" padding="{{[16, 16, 16, 16]}}">
      <poster-card
        wx:for="{{posters}}"
        wx:key="id"
        subject-id="{{item.id}}"
        image-url="{{item.imageUrl}}"
        score-label="{{item.scoreLabel}}"
        title="{{item.title}}"
        public-link
      ></poster-card>
    </grid-view>

    <list-view wx:else class="entity-list">
      <entity-row
        wx:for="{{entities}}"
        wx:key="id"
        entity-id="{{item.id}}"
        target="{{tab === 'characters' ? 'character' : 'person'}}"
        description="{{item.description}}"
        image-url="{{item.imageUrl}}"
        name="{{item.name}}"
        public-link
      ></entity-row>
    </list-view>

    <list-footer state="{{footerState}}" bindretry="onRetryMore"></list-footer>
  </scroll-view>
</view>
