{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "og:sample": "bun scripts/render-og-sample.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply bangumi-x-local --local",
    "db:migrate:prod": "wrangler d1 migrations apply bangumi-x --env production --remote",
    "cleanup:upstream:local": "wrangler d1 execute bangumi-x-local --local --file scripts/purge-upstream.sql",
    "cleanup:upstream:prod": "wrangler d1 execute bangumi-x --env production --remote --file scripts/purge-upstream.sql",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --include-runtime=false"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.13.5",
    "satori": "0.32.0",
    "share": "workspace:*",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@cloudflare/workers-types": "^5.20260907.1",
    "drizzle-kit": "^0.31.9",
    "vitest": "^4.1.0",
    "wrangler": "^4.110.0"
  }
}
