{
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "outputDirectory": ".edgeone",
  "nodeVersion": "22.11.0",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "//(.*)",
      "destination": "/$1",
      "permanent": true
    }
  ]
}
