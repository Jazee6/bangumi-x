{
  "name": "bangumi-x",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "server",
    "mini",
    "share"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --filter web --filter server --parallel dev",
    "dev:web": "bun --filter web dev",
    "dev:server": "bun --filter server dev",
    "typecheck": "bun --workspaces --if-present typecheck",
    "test": "bun test --only-failures --path-ignore-patterns 'server/**' && bun --filter server test",
    "prepare:mini": "bun scripts/prepare-mini.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@shadcn/lint": "0.1.0",
    "@types/bun": "latest",
    "miniprogram-automator": "^0.12.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
